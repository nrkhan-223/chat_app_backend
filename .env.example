# Application Settings
APP_NAME=Chat Application
DEBUG=true
API_PREFIX=/api

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatapp
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/chatapp

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# File Storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
MAX_FILE_SIZE_MB=50

# AWS S3 (if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_REGION=us-east-1

# Google Cloud Storage (if STORAGE_PROVIDER=gcs)
# GCS_BUCKET_NAME=your-bucket-name
# GCS_CREDENTIALS_FILE=/path/to/credentials.json

# Presence Settings
PRESENCE_OFFLINE_DELAY_SECONDS=30

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
