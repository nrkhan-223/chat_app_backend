# Chat Application Backend - Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME=Chat Application
DEBUG=true
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatapp
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/chatapp

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis (for multi-worker pub/sub)
REDIS_URL=redis://localhost:6379/0

# File Storage - choose one: "s3", "gcs", or "local"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_REGION=us-east-1

# Google Cloud Storage (if STORAGE_PROVIDER=gcs)
# GCS_BUCKET_NAME=your-bucket-name
# GCS_CREDENTIALS_FILE=/path/to/credentials.json

# Presence
PRESENCE_OFFLINE_DELAY_SECONDS=30

# CORS Origins (comma-separated in code, list in .env)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
